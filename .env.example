# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# URL-encode special characters in the password.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sillage?schema=public"

# --- Auth ---
# Secret for signing sessions/tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-long-random-string"

# --- App ---
# Public base URL of the app (NEXT_PUBLIC_* vars are exposed to the browser — no secrets here).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
